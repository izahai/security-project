# Copy to setup/.env (gitignored) and fill in. bootstrap.sh sources it.
# Or just export these -- real env vars win over the file.

# Where the big stuff lives: conda envs' caches, HF weights, checkpoints, images.
# Point this at the mounted volume on a rented VM, NOT the boot disk. Needs ~100 GB.
AEGIS_DATA_ROOT=/workspace/aegis-data

# huggingface.co/settings/tokens -- also accept the licence on
# CompVis/stable-diffusion-v-1-4-original, or the ckpt download 401s.
HF_TOKEN=

# Optional. Unset means training runs with W&B disabled.
WANDB_API_KEY=

# Google Drive id of the COCO-10k image archive (from the AEGIS README).
# Only needed for FID; leave blank to skip that download.
COCO_DRIVE_ID=
